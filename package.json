{
  "name": "selecle-cli",
  "version": "0.3.0",
  "description": "A haunted multiplayer terminal workspace: AI spirits (Kiro CLI) edit your project on git branches while friends join over Telnet.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ashu90-prog/selecle.git"
  },
  "homepage": "https://github.com/ashu90-prog/selecle#readme",
  "bugs": {
    "url": "https://github.com/ashu90-prog/selecle/issues"
  },
  "files": [
    "bin",
    "src",
    "assets/banner.json",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "cli",
    "terminal",
    "telnet",
    "ai-agents",
    "claude-code",
    "kiro",
    "antigravity",
    "git",
    "multiplayer"
  ],
  "type": "module",
  "bin": {
    "selecle": "bin/selecle.js"
  },
  "scripts": {
    "start": "node bin/selecle.js",
    "test": "node --test",
    "playground": "node scripts/make-playground.js",
    "ana": "node bin/selecle.js playground --name ana",
    "bob": "node bin/selecle.js playground --name bob",
    "ana:real": "node bin/selecle.js playground --name ana --real",
    "bob:real": "node bin/selecle.js playground --name bob --real",
    "host": "node bin/selecle.js host playground",
    "join": "node bin/selecle.js join"
  },
  "engines": {
    "node": ">=18"
  }
}
